# syntax=docker/dockerfile:1.7
# PAIMANA demo images (docker-compose.demo.yml; docs/DEPLOYMENT.md, Demo): the whole app on one laptop with one
# command and no setup. Two targets:
#   api  the api of Dockerfile.api with the repository's data and model inside it (dataset/, model/, the JSON stores
#        in database/), so nothing is bind-mounted; Dockerfile.demo.dockerignore lets them in, the git-ignored
#        intermediates and every secret stay out
#   web  the dashboard of Dockerfile.web behind plain-http nginx (deploy/nginx.demo.conf) for http://localhost:8080
# The stages follow Dockerfile.api and Dockerfile.web; change them together. A demo, never a deployment: the demo
# compose file turns on the one-click sign-in and uses a fixed database password.

FROM python:3.13-slim AS pydeps
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends build-essential && rm -rf /var/lib/apt/lists/*
RUN python -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
COPY requirements.txt /tmp/requirements.txt
RUN pip install -r /tmp/requirements.txt

FROM node:22-alpine AS webbuild
ARG VITE_API_BASE=
ENV VITE_API_BASE=${VITE_API_BASE}
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM python:3.13-slim AS api
ARG APP_UID=1000
ARG APP_GID=1000
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH=/opt/venv/bin:$PATH \
    HOME=/tmp MPLCONFIGDIR=/tmp/mpl NUMBA_CACHE_DIR=/tmp/numba
# libgomp1 is LightGBM's OpenMP runtime
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/* \
    && groupadd -g "${APP_GID}" app && useradd -u "${APP_UID}" -g app -d /tmp -s /usr/sbin/nologin app
COPY --from=pydeps /opt/venv /opt/venv
WORKDIR /app
# the code, the data and the model; the api writes into dataset/ (the watcher, the live jobs), database/ and temp/,
# which stay in the container until `docker compose down` resets it to the image
COPY --chown=app:app . /app
RUN chmod 0755 /app/deploy/api-entrypoint.sh /app/deploy/demo-init.sh \
    && mkdir -p dataset/raw/inbox dataset/rag database temp .tmp \
    && chown app:app dataset/raw/inbox dataset/rag database temp .tmp
USER app
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD ["python", "-c", "import sys, urllib.request; r = urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=4); sys.exit(0 if r.status == 200 else 1)"]
ENTRYPOINT ["/app/deploy/api-entrypoint.sh"]
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", \
     "--timeout-graceful-shutdown", "10", "--no-proxy-headers", "--no-access-log"]

FROM nginx:1.27-alpine AS web
RUN rm -f /etc/nginx/conf.d/default.conf
COPY deploy/nginx.conf /etc/nginx/nginx.conf
COPY deploy/nginx.demo.conf /etc/nginx/conf.d/paimana.conf
COPY --from=webbuild /app/frontend/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1
