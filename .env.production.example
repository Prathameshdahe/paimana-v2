# PAIMANA production settings: copy to .env next to docker-compose.yml (scripts/first-run.* does). Docker Compose
# reads it for the ${...} defaults in the compose files, and the api and migrate containers get every line of it as
# environment (env_file). The database credentials are NOT here: .env.db holds POSTGRES_USER, POSTGRES_PASSWORD,
# POSTGRES_DB, POSTGRES_PORT and a host-side DATABASE_URL, written by scripts/first-run.* with a generated
# password. The administrator's password is typed at the bootstrap prompt and never stored in a file.
# Every setting the api reads is described in .env.example as well; docs/DEPLOYMENT.md explains the stack.

# ---- The stack (docker-compose.yml) ----------------------------------------------------------------------------
# nginx server_name: the domain of a real server ("_" answers any name). Change ALLOWED_ORIGINS and ALLOWED_HOSTS
# with it.
SERVER_NAME=localhost
# Published ports of the web container, the only published ports (docker-compose.dev.yml uses 8080 and 8443).
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
# The compose network. TRUSTED_PROXIES below must be the same block: the api believes X-Forwarded-For from it.
PAIMANA_SUBNET=10.201.0.0/24
# LM Studio as seen from the api container: host.docker.internal is the Docker host (on Linux, LM Studio must serve
# on 0.0.0.0, not only on 127.0.0.1). This becomes the container's LLM_BASE_URL.
LM_STUDIO_URL=http://host.docker.internal:1234/v1
# The daily pg_dump by the backup container: the UTC hour, and how many days of dumps ./backups keeps.
BACKUP_HOUR=02
BACKUP_KEEP_DAYS=14

# ---- Api security (backend/settings.py; docs/SECURITY.md) -------------------------------------------------------
# 1: session cookies carry the Secure flag. Keep 1: the stack serves https only.
SECURE_COOKIES=1
# Comma-separated origins allowed to call the api with a session (CORS, and the Origin check on every write): the
# exact https URL users open, no trailing slash. A real server: https://radar.example.gov.in
ALLOWED_ORIGINS=https://localhost
# Host header values the api accepts (TrustedHost). Keep 127.0.0.1: the container's own health probe uses it.
ALLOWED_HOSTS=localhost,127.0.0.1
# CIDRs whose X-Forwarded-For the api trusts: the compose network (the web container is the proxy).
TRUSTED_PROXIES=10.201.0.0/24
# Session lifetime: hours idle, days absolute.
SESSION_IDLE_H=12
SESSION_MAX_D=7
# Comma-separated email domains allowed to request access; empty means any.
ALLOWED_EMAIL_DOMAINS=
# Optional default email for python -m backend.auth.bootstrap.
ADMIN_EMAIL=
# /docs, /redoc and /openapi.json stay off in production.
API_DOCS=0
# The one-click demo sign-in (a password-less sign-in to any role, for recording a prototype) stays off.
DEMO_LOGIN=0
# The hidden developer account (every feature, never listed to administrators): the api creates or updates it at every
# start when both are set. They are secrets and belong in .env.db, not in this file; PAIMANA_ADMIN_PASSWORD likewise
# (the first-run script asks for the administrator's password instead).
# PAIMANA_DEVELOPER_EMAIL=
# PAIMANA_DEVELOPER_PASSWORD=
# PAIMANA_ADMIN_PASSWORD=
# DuckDB (the analytics engine) memory ceiling and threads inside the 4 GB api container.
DUCKDB_MEMORY_LIMIT=2GB
DUCKDB_THREADS=4

# ---- Local LLM (LM Studio) -------------------------------------------------------------------------------------
LLM_MODEL=qwen/qwen2.5-coder-14b
# Optional: a smaller instruct model for the chat planner and writer only; empty uses LLM_MODEL.
LLM_CHAT_MODEL=
# 0: the assistant never calls the LLM; it answers with its cards and a summary built from the data.
CHAT_WRITER=1
# The embedding model of the assistant's search index; without it the search runs on keywords alone.
LLM_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
# 0 ranks the assistant's search on keywords alone and never calls the embedding model.
RAG_EMBED=1

# ---- Live jobs (backend/live/scheduler.py) ---------------------------------------------------------------------
# 0 turns every background loop off (the report watcher, the news scout, the research agent, the second opinion).
LIVE_JOBS=1
WATCH_INTERVAL_S=60
SCOUT_INTERVAL_H=24
RESEARCH_AGENT=1
RESEARCH_PER_RUN=20
RESEARCH_INTERVAL_H=24
SECOND_OPINION_JOB=1
SECOND_OPINION_PER_RUN=15
SECOND_OPINION_INTERVAL_H=24
# The PARIVESH snapshot (every 6 h) and the Bhoomi Rashi pull (off by default; every 91 days when on).
PARIVESH_SNAPSHOT=1
PARIVESH_SNAPSHOT_INTERVAL_H=6
BHOOMI_PULL=0
BHOOMI_PULL_EVERY_D=91
# Optional: another PIB feed for the scout.
# PIB_RSS=https://pib.gov.in/RssMain.aspx?ModId=6&Lang=1&Regid=3
