# syntax=docker/dockerfile:1.7
# PAIMANA web image (docs/DEPLOYMENT.md): the dashboard built by node:22 (npm ci && npm run build -> frontend/dist)
# and served by nginx 1.27 with deploy/nginx.conf.template (TLS, security headers, rate limits, the /api/ proxy). The
# build context is the repo root because vite.config.ts reads its env from there; .dockerignore keeps .env out, so
# the bundle's API base is the VITE_API_BASE build arg: empty means same origin, which is what nginx serves.
FROM node:22-alpine AS build
ARG VITE_API_BASE=
ENV VITE_API_BASE=${VITE_API_BASE}
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine
# the image's entrypoint renders /etc/nginx/templates/*.template into /etc/nginx/conf.d with envsubst; the filter
# limits substitution to ${PAIMANA_*}, so nginx's own $variables in the template stay as they are
ENV NGINX_ENVSUBST_FILTER=^PAIMANA_ PAIMANA_SERVER_NAME=_ PAIMANA_HTTPS_SUFFIX=""
RUN rm -f /etc/nginx/conf.d/default.conf
COPY deploy/nginx.conf /etc/nginx/nginx.conf
COPY deploy/nginx.conf.template /etc/nginx/templates/paimana.conf.template
COPY --from=build /app/frontend/dist /usr/share/nginx/html
EXPOSE 80 443
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1
