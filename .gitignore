# env
.env
.env.*
!.env.example
!.env.production.example

# production stack (docs/DEPLOYMENT.md): database dumps and TLS certificates stay on the host
backups/
deploy/certs/*
!deploy/certs/README.md

# node
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*

# python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# scratch
temp/*
!temp/.gitkeep

# editor / os
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db

# large data: shared via the team drive, not git
Dataset drive folder/
dataset.zip
dataset/clean/_parts/
dataset/clean/performance/performance_detail.csv
dataset/clean/projects/project_summaries.csv
dataset/clean/projects/projects_monthly.csv
dataset/clean/projects/projects_quarterly.csv
mlruns/

# Silver reproducible outputs (run pipeline.run silver to regenerate)
dataset/silver/typed_rows.parquet
dataset/silver/identity/resolved_rows.parquet

# the SQLite app state of earlier versions (python -m backend.db.migrate_sqlite copies it into PostgreSQL once)
database/*.db
database/*.db-journal

# production stack (docs/DEPLOYMENT.md): database dumps and TLS certificates stay on the host
backups/
deploy/certs/*
!deploy/certs/README.md

# report inbox: files wait here for the live watcher (backend/live/watcher.py)
dataset/raw/inbox/*
!dataset/raw/inbox/README.md

# the assistant's search index (python -m llm.rag build; rebuilt by the backend when its inputs change)
dataset/rag/
