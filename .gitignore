# env
.env
.env.*
!.env.example
!.env.production.example

# production stack: database dumps and TLS certificates stay on the host
backups/
deploy/certs/*
!deploy/certs/README.md

# node
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*

# python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# scratch
temp/*
!temp/.gitkeep

# editor / os
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db

# large data: shared via the team drive, not git
Dataset drive folder/
dataset.zip
paimana-demo-images.tar*
dataset/clean/_parts/
mlruns/

# Silver reproducible outputs (python -m pipeline.run silver)
dataset/silver/typed_rows.parquet
dataset/silver/identity/resolved_rows.parquet

# the SQLite app state of earlier versions
database/*.db
database/*.db-journal

# report inbox: files wait here for the live watcher
dataset/raw/inbox/*
!dataset/raw/inbox/README.md

# the assistant's search index (rebuilt by the backend when inputs change)
dataset/rag/

# ── SIH: data and docs kept local, not on GitHub ─────────────────────────────

# All clean dataset CSVs and gold/silver outputs (reproduced by running the pipeline)
dataset/clean/
dataset/gold/
dataset/silver/

# Model run artifacts (reproduced by ml/train.py) — not shared
model/runs/
model/experiments/
model/*.json

# Docs — kept local for team reference, not visible on GitHub
# README.md is NOT listed here so it stays on GitHub
docs/*.md
docs/screenshots/
