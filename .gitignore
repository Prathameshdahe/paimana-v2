# env
.env
.env.*
!.env.example
!.env.production.example

# production stack: database dumps and TLS certificates stay on the host
backups/
deploy/certs/*
!deploy/certs/README.md

# node
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*

# python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# scratch
temp/*
!temp/.gitkeep

# editor / os
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db

# large data and ML runs
Dataset drive folder/
dataset.zip
paimana-demo-images.tar*
mlruns/

# Silver reproducible intermediate outputs
dataset/silver/typed_rows.parquet
dataset/silver/identity/resolved_rows.parquet

# SQLite databases and state
database/*.db
database/*.db-journal
database/*.json
database/postgres/tests/sample_predictions_v1.csv
database/postgres/tests/sample_*.json

# ── SIH submission: the data, the trained models and the internal write-ups stay on this machine ──────────────────
# The repository carries the code only. A fresh clone has no dataset/, model/ or docs/ (except the public help text);
# the tests that need them skip (tests/conftest.py, needs_local_data) and the demo image is built from a local checkout.

# The whole dataset tree: raw reports, silver, gold, features, labels, predictions, external and research sweeps
dataset/

# Every trained model and run: registry, joblib / LightGBM files, backtest, calibration, SHAP and slice tables
model/

# Internal documentation and data contracts; docs/HELP.md is the public help text the assistant quotes at runtime,
# so it is the one file that ships (root README.md is the owner's and ships too)
docs/*
!docs/HELP.md
database/postgres/*.md
database/postgres/README.md
pipeline/identity/README.md
frontend/README.md

# The app's local runtime state (worker drafts carry project names and scores) and samples built from the data
database/*.json
database/postgres/tests/sample_*
frontend/src/mocks/

# Safety net: a data, model or table file added by accident anywhere else stays out too
*.parquet
*.joblib
*.pkl
*.csv
*.xlsx
*.xls
*.sqlite
*.sqlite3
