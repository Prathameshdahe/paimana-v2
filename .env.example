# Local LLM (LM Studio, OpenAI-compatible server)
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen/qwen2.5-coder-14b
# Optional: the model of the assistant's chat calls (llm/client.py chat, chat_stream); empty uses LLM_MODEL.
# LLM_CHAT_MODEL=
# The embedding model of the assistant's search index (llm/rag.py). Load it in LM Studio next to the chat model;
# without it the search runs on keywords alone.
LLM_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
# 0 ranks the assistant's search on keywords alone and never calls the embedding model.
# RAG_EMBED=1

# Frontend -> backend URL (Vite only exposes vars prefixed with VITE_)
VITE_API_BASE=http://localhost:8000

# Live tracking (backend/live/): background loops inside the backend process.
# LIVE_JOBS=0 turns the inbox watcher and the news scout off (the tests do).
LIVE_JOBS=1
# Seconds between checks of dataset/raw/inbox/.
WATCH_INTERVAL_S=60
# Hours between news-scout batches; the first batch runs 10 minutes after start.
SCOUT_INTERVAL_H=24
# Optional: the PIB feed the scout reads, and the SQLite app-state file.
# PIB_RSS=https://pib.gov.in/RssMain.aspx?ModId=6&Lang=1&Regid=3
# PAIMANA_DB=database/paimana.db
