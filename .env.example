# Local LLM (LM Studio, OpenAI-compatible server)
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen/qwen2.5-coder-14b
# Optional: the model of the assistant's chat planner and writer only; empty uses LLM_MODEL. The brief, the worker
# cell, the research agent and the second opinion stay on LLM_MODEL. A smaller instruct model answers the chat faster
# (docs/AI_ASSISTANT.md, Speed); LM Studio then serves both models.
# LLM_CHAT_MODEL=
# 0: the assistant never calls the LLM; it answers with its cards and a summary built from the data.
# CHAT_WRITER=1
# The embedding model of the assistant's search index (llm/rag.py). Load it in LM Studio next to the chat model;
# without it the search runs on keywords alone.
LLM_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
# 0 ranks the assistant's search on keywords alone and never calls the embedding model.
# RAG_EMBED=1

# Frontend -> backend URL (Vite only exposes vars prefixed with VITE_)
VITE_API_BASE=http://localhost:8000

# Live tracking (backend/live/): background loops inside the backend process.
# LIVE_JOBS=0 turns every background loop off (the inbox watcher, the news scout, the portal jobs, the research
# agent and the second opinion, whatever their own switches below say) and the search-index warm-up; the tests do.
LIVE_JOBS=1
# Seconds between checks of dataset/raw/inbox/.
WATCH_INTERVAL_S=60
# Hours between news-scout batches; the first batch runs 10 minutes after start.
SCOUT_INTERVAL_H=24
# Research agent (backend/live/research.py): judges the scout's news items with the local LLM into cited
# research facts, a batch of projects a run (watchlist, then Critical / High / Watch); the first run is 30 minutes
# after start. RESEARCH_AGENT=0 turns it off.
RESEARCH_AGENT=1
RESEARCH_PER_RUN=20
RESEARCH_INTERVAL_H=24
# Second opinion (llm/second_opinion.py): the local LLM's cited reading of a project's evidence next to the model's
# tier (it never changes the tier). The nightly job asks it for up to SECOND_OPINION_PER_RUN Critical / High / Watch
# projects whose evidence has none yet; the first run is 45 minutes after start. SECOND_OPINION_JOB=0 turns the job
# off (an official can still ask for one on the project page).
SECOND_OPINION_JOB=1
SECOND_OPINION_PER_RUN=15
SECOND_OPINION_INTERVAL_H=24
# Optional: the PIB feed the scout reads.
# PIB_RSS=https://pib.gov.in/RssMain.aspx?ModId=6&Lang=1&Regid=3

# PostgreSQL: the app's state (alerts, watchlists, news signals, research facts, second opinions, audit log, users)
# and the serving tables (docs/DATABASE.md). The dev server runs in Docker on port 5433 (docker-compose.dev.yml); the
# credentials live in .env.db (gitignored, generated by scripts/first-run): POSTGRES_USER, POSTGRES_PASSWORD,
# POSTGRES_DB, POSTGRES_PORT and DATABASE_URL. backend/settings.py reads .env, then .env.db, then the process
# environment. Without DATABASE_URL it builds one from POSTGRES_* (or Manamrit's DB_USER/DB_PASSWORD/DB_HOST/DB_PORT/
# DB_NAME) on localhost.
# DATABASE_URL=postgresql+psycopg://paimana:<password>@localhost:5433/paimana
# Inside the compose stack POSTGRES_HOST is set and the URL is built from POSTGRES_* instead (backend/settings.py).
# The tests use the database paimana_test on the same server (DATABASE_URL with the name swapped); a
# TEST_DATABASE_URL in the environment points them elsewhere (the CI's Postgres service).

# Backend settings (backend/settings.py; env names are the upper-case field names).
# 1 marks the session cookie Secure: set it in production behind TLS.
SECURE_COOKIES=0
# Browser origins allowed to call the API with credentials (CORS) and to send non-GET requests, comma-separated.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
# Host names the API answers to (TrustedHost); * in dev, the server's domain in production.
ALLOWED_HOSTS=*
# Reverse proxies whose X-Forwarded-For is believed, as CIDRs (empty: none; the compose stack's nginx is 172.16.0.0/12).
TRUSTED_PROXIES=
# A session ends after this many idle hours, and after this many days whatever happens.
SESSION_IDLE_H=12
SESSION_MAX_D=7
# DuckDB (backend/serving.py): memory cap and threads of the analytics reads.
DUCKDB_MEMORY_LIMIT=2GB
DUCKDB_THREADS=4
# Optional: the first administrator's email for python -m backend.auth.bootstrap (it can be given on the command
# line instead), and the email domains sign-up requests may come from, comma-separated (empty: any).
# ADMIN_EMAIL=
ALLOWED_EMAIL_DOMAINS=
