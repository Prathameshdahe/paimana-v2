# Local LLM (LM Studio, OpenAI-compatible server)
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen/qwen2.5-coder-14b
# Optional: the model of the assistant's chat calls (llm/client.py chat, chat_stream); empty uses LLM_MODEL.
# A smaller instruct model answers faster (docs/AI_ASSISTANT.md, Speed).
# LLM_CHAT_MODEL=
# 0: the assistant never calls the LLM; it answers with its cards and a summary built from the data.
# CHAT_WRITER=1
# The embedding model of the assistant's search index (llm/rag.py). Load it in LM Studio next to the chat model;
# without it the search runs on keywords alone.
LLM_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
# 0 ranks the assistant's search on keywords alone and never calls the embedding model.
# RAG_EMBED=1

# Frontend -> backend URL (Vite only exposes vars prefixed with VITE_)
VITE_API_BASE=http://localhost:8000

# Live tracking (backend/live/): background loops inside the backend process.
# LIVE_JOBS=0 turns the inbox watcher and the news scout off (the tests do).
LIVE_JOBS=1
# Seconds between checks of dataset/raw/inbox/.
WATCH_INTERVAL_S=60
# Hours between news-scout batches; the first batch runs 10 minutes after start.
SCOUT_INTERVAL_H=24
# Research agent (backend/live/research.py): judges the scout's news items with the local LLM into cited
# research facts, a batch of projects a run (watchlist, then Critical / High / Watch); the first run is 30 minutes
# after start. RESEARCH_AGENT=0 turns it off.
RESEARCH_AGENT=1
RESEARCH_PER_RUN=20
RESEARCH_INTERVAL_H=24
# Second opinion (llm/second_opinion.py): the local LLM's cited reading of a project's evidence next to the model's
# tier (it never changes the tier). The nightly job asks it for up to SECOND_OPINION_PER_RUN Critical / High / Watch
# projects whose evidence has none yet; the first run is 45 minutes after start. SECOND_OPINION_JOB=0 turns the job
# off (an official can still ask for one on the project page).
SECOND_OPINION_JOB=1
SECOND_OPINION_PER_RUN=15
SECOND_OPINION_INTERVAL_H=24
# Optional: the PIB feed the scout reads, and the SQLite app-state file.
# PIB_RSS=https://pib.gov.in/RssMain.aspx?ModId=6&Lang=1&Regid=3
# PAIMANA_DB=database/paimana.db
